// For editors only (for example VS Code with the Vue extension): nothing is
// compiled from it. It points `vue` and `chemunited` at the declarations in
// types/, which `chemunited-workflow ui init` refreshes from the installed package.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "paths": {
      "vue": ["./types/vue/index.d.ts"],
      "@vue/*": ["./types/@vue/*/index.d.ts"],
      "csstype": ["./types/csstype/index.d.ts"],
      "chemunited": ["./types/chemunited.d.ts"]
    }
  },
  "include": ["**/*.vue", "**/*.ts", "**/*.js"],
  "exclude": ["dist", "vendor"]
}
