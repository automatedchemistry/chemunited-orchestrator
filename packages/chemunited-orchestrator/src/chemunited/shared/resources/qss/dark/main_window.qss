Widget > QLabel {
    font: 24px 'Segoe UI', 'Microsoft YaHei';
}


QWidget {
    border-right: none;
    border-bottom: none;
    border-top: none;
    border-left: none;
    background-color: rgb(39, 39, 39);
}

QGraphicsView {
    border-right: none;
    border-bottom: none;
    border-top: none;
    border-left: none;
    background-color: rgb(39, 39, 39);
}
