        <mxCell id="leg2" value="&lt;b&gt;Mode 2&lt;/b&gt;  (real_time=True)&lt;br&gt;&lt;font style=&#39;font-size:9px&#39;&gt;• historical_file not used&lt;br&gt;• No Workflow Thread&lt;br&gt;• Commands via POST /command&lt;br&gt;• Clock throttled to wall clock&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0e6;strokeColor=#d6a35c;align=left;spacingLeft=8;" parent="1" vertex="1">
